{
  "name": "siosia",
  "private": true,
  "version": "2.12.1",
  "type": "module",
  "description": "Siosia — a mobile-first ride-hailing web app: one link, ride or drive, zero running cost.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "icons": "node scripts/make-icons.mjs",
    "invite-hash": "node scripts/invite-hash.mjs",
    "smoke": "node scripts/smoke-supabase.mjs",
    "push:bundle": "esbuild supabase/functions/push-dispatch/index.ts --bundle --format=esm --platform=neutral --external:npm:* --outfile=supabase/functions/push-dispatch/dist-bundle.ts",
    "calendar:bundle": "esbuild supabase/functions/calendar/index.ts --bundle --format=esm --platform=neutral --external:npm:* --outfile=supabase/functions/calendar/dist-bundle.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
