# Siosia build-time configuration. Copy to .env.local and fill in.
# Leave the two Supabase values empty to build the in-browser DEMO (mock backend).

# Supabase → Project Settings → API (or "Connect"): Project URL + publishable key.
# Only the PUBLISHABLE key (sb_publishable_… or the legacy "anon" key) may go here — never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Force a backend: "mock" or "supabase". Empty = supabase when the URL is set, otherwise mock.
VITE_BACKEND=

# Shown on the "Service unavailable" screen so users know whom to contact.
VITE_OPERATOR_CONTACT=

# Base path the site is served from. "./" works on any host (GitHub Pages sub-path included).
BASE_PATH=./
